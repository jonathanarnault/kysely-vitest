{
	"name": "@kysely-vitest/core",
	"version": "0.5.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonathanarnault/kysely-vitest.git",
		"directory": "packages/core"
	},
	"scripts": {
		"build": "tsc --build --force tsconfig.lib.json",
		"typecheck": "tsc --noEmit -p tsconfig.lib.json -p tsconfig.test.json",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"peerDependencies": {
		"kysely": "catalog:",
		"vitest": "catalog:peers"
	},
	"devDependencies": {
		"postgres": "catalog:",
		"vitest": "catalog:"
	},
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
